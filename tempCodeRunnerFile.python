import numpy as np

def substituicao_regressiva(A, b):
    n = len(b)
    x = np.zeros(n)

    for i in range(n - 1, -1, -1):
        soma = np.dot(A[i, i+1:], x[i+1:])
        x[i] = (b[i] - soma) / A[i, i]

    return x


def main():
    A = np.array([
        [2, 3, -1],
        [0, 4,  2],
        [0, 0,  5]
    ], dtype=float)

    b = np.array([5, 10, 15], dtype=float)

    x = substituicao_regressiva(A, b)

    print("Solução:")
    print(x)

if __name__ == "__main__":
    main()